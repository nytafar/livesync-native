# The upstream release lsync is built and tested against: the single source
# of truth for it (AGENTS.md, "Bumping upstream"). Change it only with
# scripts/bump-upstream.sh, which moves everything else along; the gate test
# crates/livesync-model/tests/upstream_pin.rs fails when anything disagrees.
#
# Format: KEY=value lines (no quotes, no spaces), `#` comments. Read by bash
# (scripts/upstream.sh get KEY), by Rust at compile time
# (crates/livesync-model/build.rs -> livesync_model::upstream) and by node
# (tools/golden/generate.mjs).

# Self-hosted LiveSync (plugin and official CLI): the release tag. The CLI of
# that release reports itself as <tag>-cli.
PLUGIN_RELEASE=1.0.49
# @vrtmrz/livesync-commonlib, as that release's package.json pins it.
COMMONLIB=0.4.3
# octagonal-wheels, as that commonlib pins it.
OCTAGONAL_WHEELS=0.1.56
# The glob matcher commonlib resolves to in that release's package-lock.json
# (tools/golden/package.json `overrides`), so the ignore vectors are what the
# plugin and the CLI do.
MINIMATCH=11.0.4
NONRECURSIVE_GLOB_MATCH=1.0.3
BRACE_EXPANSION=5.0.12
